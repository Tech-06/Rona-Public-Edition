[Unit]
Description=Rona Web Dashboard
After=network.target rona.service

[Service]
Type=simple
WorkingDirectory=%h/rona/web-client
Environment=WEB_HOST=127.0.0.1
Environment=WEB_PORT=8016
EnvironmentFile=%h/rona/web-client/.env
ExecStart=%h/rona/web-client/.venv/bin/python -m uvicorn webui.server:app --host ${WEB_HOST} --port ${WEB_PORT}
Restart=always
RestartSec=2
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=yes
# On hosts that restrict unprivileged user namespaces (e.g. some Ubuntu 24.04
# AppArmor setups), user units using PrivateTmp/ProtectSystem/ProtectHome can
# fail with status 226/NAMESPACE. In that case remove those three lines.
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# The dashboard also writes into backend/: package install/update/uninstall
# (webui/package_jobs.py runs toolbox.manager there: toolbox/custom, pip into
# backend/.venv) and webui/host.py (backend_spawn.log, starting the backend).
ReadWritePaths=%h/rona/web-client %h/rona/backend
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=default.target
