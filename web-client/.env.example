LOG_LEVEL=INFO
# The dashboard's default language (tr or en) -- a viewer can still switch
# it from Settings > Appearance without touching this. Change with
# `rona edit lang`, or here directly (needs a restart either way).
UI_LANGUAGE=tr
# Must match AUTH_TOKEN in the backend's own .env — this dashboard uses it
# to authenticate its proxied requests to the backend.
AUTH_TOKEN=

WEB_HOST=127.0.0.1
WEB_PORT=8016
BACKEND_URL=http://127.0.0.1:8000
WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Dashboard login. Set the password with `rona web password` (or let the
# installer do it) -- never edit WEB_PASSWORD_HASH by hand. Changing the
# password also rotates WEB_SESSION_SECRET, which signs the login cookie;
# neither needs a restart (values in this file outrank
# same-named process environment variables, e.g. from a systemd EnvironmentFile). Without a password the panel stays locked, and it
# refuses to start at all when WEB_HOST is not a loopback address.
WEB_PASSWORD_HASH=
WEB_SESSION_SECRET=
WEB_SESSION_DAYS=30
# auto = Secure cookie when served over HTTPS (also behind a proxy that sets
# X-Forwarded-Proto); true / false to force it.
WEB_COOKIE_SECURE=auto

# Path to the backend checkout, used only by the optional local
# process-supervision/log-tail/db-read conveniences in host.py/db.py.
# Leave as the default if backend/ and web-client/ are sibling folders;
# those features simply report "unavailable" if the path doesn't resolve.
BACKEND_DIR=../backend
BACKEND_LOG_FILE=rona.log
