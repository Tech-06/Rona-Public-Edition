LOG_LEVEL=INFO
# Must match AUTH_TOKEN in the backend's own .env — this dashboard uses it
# to authenticate its proxied requests to the backend.
AUTH_TOKEN=

WEB_HOST=127.0.0.1
WEB_PORT=8016
BACKEND_URL=http://127.0.0.1:8000
WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Path to the backend checkout, used only by the optional local
# process-supervision/log-tail/db-read conveniences in host.py/db.py.
# Leave as the default if backend/ and web-client/ are sibling folders;
# those features simply report "unavailable" if the path doesn't resolve.
BACKEND_DIR=../backend
BACKEND_LOG_FILE=rona.log
