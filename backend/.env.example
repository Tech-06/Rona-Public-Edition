RELOAD=true
LOG_LEVEL=INFO
LOG_FILE=rona.log
# Rona's speaking language (persona prompt) and the language of every
# backend-authored message a human sees (HTTPException details, stored
# task/subagent run outcomes, log lines). tr or en. Change with
# `rona edit lang`, or here directly (needs a restart either way).
LANGUAGE=tr
AUTH_TOKEN=
FLASH_MODEL=
FLASH_MODEL_URL=
FLASH_MODEL_API=
FLASH_MODEL_HEADERS={}
PRO_MODEL=
PRO_MODEL_URL=
PRO_MODEL_API=
PRO_MODEL_HEADERS={}
CONVERSATION_TTL_SECONDS=0
MAX_HISTORY_MESSAGES=50
LLM_TIMEOUT_SECONDS=120
GRAPH_RECURSION_LIMIT=100
SUBAGENT_MAX_ROUNDS=50
SUBAGENT_TIMEOUT_SECONDS=1800
SUBAGENT_MAX_CONCURRENT=3
SUBAGENT_RETENTION_HOURS=24
SUBAGENT_LLM_TIMEOUT_SECONDS=300
SUBAGENT_MAX_CONTEXT_MESSAGES=40
TRIGGER_TIMEZONE=UTC
TRIGGER_MAX_CONCURRENT=2
TRIGGER_MAX_ROUNDS=30
TRIGGER_LLM_TIMEOUT_SECONDS=300
TRIGGER_MAX_CONTEXT_MESSAGES=30
EMBEDDING_MODEL_NAME=
GOOGLE_API_KEY=
# Optional tool packages (web search, weather, translation, Google
# Calendar/Contacts/Mail, ...) are not installed by default -- pull one in
# with `python -m toolbox.manager install <id>` from the Rona Tools catalog.
# Its own API key/secret (e.g. TAVILY_API_KEY, DEEPL_API_KEY) is then added
# to this file automatically during that install, so none are listed here.
# Spawn the web dashboard (../web-client by default) as a subprocess on
# startup. The dashboard's own host/port/allowed-hosts live in its own
# .env now that it's deployed as a separate component.
WEB_AUTOSTART=false
WEB_CLIENT_DIR=../web-client
