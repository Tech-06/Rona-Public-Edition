# --- Optional tool packages ---------------------------------------------
# Core tools live in this repository (toolbox/tools/ + toolbox/tools.json).
# Optional ones deliberately do not: toolbox.manager fetches them on demand
# from the separate Rona Tools catalog (github.com/Tech-06/Rona-Tools) and
# installs them here. Everything under custom/ is therefore per-machine
# state that must never enter a commit -- the downloaded package source,
# the config.json the installer wrote, the credentials/tokens a package
# stored, and installed.json, which records what *this* machine has.
# Installing a package must leave `git status` clean.
backend/toolbox/custom/*
# ...except the two files that keep this an importable package in a fresh
# clone. registry.py imports installed tools as `toolbox.custom.<id>`, so
# the folder has to survive a checkout even with nothing installed.
!backend/toolbox/custom/__init__.py
!backend/toolbox/custom/.gitkeep

# Credentials a tool package stores next to its own code (google_auth writes
# both). Name-based on purpose: this guarantee then holds independently of
# the directory rules above, so a future negation there can't expose them.
# The ** also still covers the pre-split location, toolbox/tools/ -- an
# installation upgraded from an older Rona keeps its Google files there and
# they are not migrated automatically (see the upgrade note in README.md).
backend/toolbox/**/credentials.json
backend/toolbox/**/token_*.json

