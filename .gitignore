# OS
.DS_Store
Thumbs.db

# Rona backend local data
backend/rona.log
backend/rona.log.*
backend/rona.db
backend/rona.db-wal
backend/rona.db-shm
backend/rona_checkpoints.db
backend/rona_checkpoints.db-wal
backend/rona_checkpoints.db-shm
backend/toolbox/tools/credentials.json
backend/toolbox/tools/token_*.json
backend/backend_spawn.log
# Written by `rona server start` (see cli/) when it spawns the backend
# itself instead of delegating to systemd.
backend/rona.pid

# rona CLI (cli/)
cli/.venv/
cli/rona_cli.egg-info/

# Installed custom tool packages (fetched on demand by toolbox.manager from
# the separate Rona Tools repo) and their local lockfile/config -- not part
# of the template, regenerated per install.
backend/toolbox/custom/*
!backend/toolbox/custom/__init__.py
!backend/toolbox/custom/.gitkeep

# Web client
web-client/node_modules/
web-client/frontend/node_modules/
web-client/frontend/*.tsbuildinfo
web-client/frontend/vite.config.js
web-client/frontend/vite.config.d.ts
web-client/webui/dist/
web-client/webui.pid
web-client/webui.lock
web-client/webui.log
web-client/webui.log.*

# Local agent handoff docs (not part of the public template)
/project.md
/project-plan.md
